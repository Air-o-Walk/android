<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_margin="8dp"
    app:cardCornerRadius="8dp"
    app:cardElevation="4dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <!-- Nombre del premio -->
        <TextView
            android:id="@+id/txtNombrePremio"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Nombre del Premio"
            android:textSize="18sp"
            android:textStyle="bold"
            android:textColor="#333333"
            android:layout_marginBottom="8dp"/>

        <!-- Descripción del premio -->
        <TextView
            android:id="@+id/txtDescripcionPremio"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Descripción del premio"
            android:textSize="14sp"
            android:textColor="#666666"
            android:layout_marginBottom="12dp"
            android:maxLines="3"
            android:ellipsize="end"/>

        <!-- Contenedor horizontal: puntos + stock + botón -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <!-- Puntos requeridos -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Costo:"
                    android:textSize="12sp"
                    android:textColor="#999999"/>

                <TextView
                    android:id="@+id/txtPuntosRequeridos"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="500 pts"
                    android:textSize="20sp"
                    android:textStyle="bold"
                    android:textColor="#FF9800"/>

            </LinearLayout>

            <!-- Stock disponible -->
            <TextView
                android:id="@+id/txtStock"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Stock: 10"
                android:textSize="12sp"
                android:textColor="#4CAF50"
                android:layout_marginEnd="16dp"/>

            <!-- Botón canjear -->
            <Button
                android:id="@+id/btnCanjear"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Canjear"
                android:textSize="14sp"
                android:backgroundTint="#4CAF50"
                android:textColor="@android:color/white"/>

        </LinearLayout>

    </LinearLayout>

</androidx.cardview.widget.CardView>