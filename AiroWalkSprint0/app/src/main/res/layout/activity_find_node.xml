<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FDFBE2"
    android:padding="0dp">

    <!-- HEADER BAR -->
    <LinearLayout
        android:id="@+id/topBar"
        android:orientation="horizontal"
        android:layout_width="0dp"
        android:layout_height="56dp"
        android:background="#504E76"
        android:gravity="center"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <TextView
            android:id="@+id/txtTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Buscar Sensor"
            android:textColor="#FFFFFF"
            android:textSize="20sp"
            android:textStyle="bold"/>
    </LinearLayout>

    <!-- DISTANCE CIRCLE -->
    <ImageView
        android:id="@+id/distanceCircle"
        android:layout_width="240dp"
        android:layout_height="240dp"
        android:src="@drawable/circle_cold"
        android:layout_marginTop="32dp"
        app:layout_constraintTop_toBottomOf="@id/topBar"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>

    <!-- DISTANCE TEXT -->
    <TextView
        android:id="@+id/txtDistance"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Distancia: --"
        android:textColor="#504E76"
        android:textStyle="bold"
        android:textSize="20sp"
        android:layout_marginTop="18dp"
        app:layout_constraintTop_toBottomOf="@id/distanceCircle"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>

    <!-- SIGNAL BARS -->
    <ImageView
        android:id="@+id/imgSignalBars"
        android:layout_width="100dp"
        android:layout_height="100dp"
        android:src="@drawable/ic_signal_0"
        android:layout_marginTop="20dp"
        app:layout_constraintTop_toBottomOf="@id/txtDistance"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>

    <!-- LAST KNOWN LOCATION BUTTON -->
    <Button
        android:id="@+id/btnLastLocation"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginTop="28dp"
        android:background="@drawable/rounded_button_green"
        android:backgroundTint="#A3B565"
        android:paddingHorizontal="26dp"
        android:paddingVertical="12dp"
        android:text="Última ubicación"
        android:textAllCaps="false"
        android:textColor="#FFFFFF"
        android:visibility="gone"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/imgSignalBars" />

    <!-- BACK BUTTON -->
    <Button
        android:id="@+id/btnVolver"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Volver"
        android:textAllCaps="false"
        android:backgroundTint="#504E76"
        android:textColor="#FFFFFF"
        android:paddingHorizontal="26dp"
        android:paddingVertical="12dp"
        android:background="@drawable/rounded_button_purple"
        android:layout_marginTop="16dp"
        app:layout_constraintTop_toBottomOf="@id/btnLastLocation"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>
</androidx.constraintlayout.widget.ConstraintLayout>
