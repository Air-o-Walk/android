<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:gravity="center"
    android:orientation="vertical"
    android:clipChildren="false"
    android:clipToPadding="false">

    <!-- GREEN PANEL -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_panel_green"
        android:orientation="vertical"
        android:paddingTop="20dp"
        android:paddingBottom="24dp"
        android:paddingHorizontal="20dp"
        android:gravity="center_horizontal"
        android:layout_marginHorizontal="16dp">

        <!-- TITLE -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="RECUPERAR\nCONTRASEÑA"
            android:textColor="#FFFFFF"
            android:textSize="18sp"
            android:textStyle="bold"
            android:gravity="center"
            android:layout_marginBottom="6dp"/>

        <!-- SUBTITLE -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Introduce el correo asociado a tu\ncuenta de Air-o-Walk"
            android:textColor="#FFFFFF"
            android:textSize="13sp"
            android:gravity="center"
            android:layout_marginBottom="18dp"/>

        <!-- EMAIL INPUT -->
        <EditText
            android:id="@+id/editTextPopupEmail"
            android:layout_width="match_parent"
            android:layout_height="42dp"
            android:background="@drawable/bg_input"
            android:hint="Correo"
            android:textColor="#514F77"
            android:textColorHint="#8B86A3"
            android:paddingHorizontal="14dp"
            android:layout_marginBottom="16dp"/>

        <!-- RECUPERAR BUTTON -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/buttonPopupRecover"
            android:layout_width="150dp"
            android:layout_height="44dp"
            android:text="Recuperar"
            android:textColor="#000"
            android:background="@drawable/bg_btn"
            app:backgroundTint="@null"
            app:cornerRadius="40dp"
            android:layout_marginBottom="12dp"/>

        <!-- VOLVER BUTTON -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/buttonPopupLogin"
            android:layout_width="150dp"
            android:layout_height="44dp"
            android:text="Volver"
            android:textColor="#000"
            android:background="@drawable/bg_btn_green"
            app:backgroundTint="@null"
            app:cornerRadius="40dp"/>

    </LinearLayout>

</LinearLayout>
