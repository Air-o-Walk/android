<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#EFEAD6">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <!-- ========= HEADER PLACEHOLDER (Simple Bar) ========= -->
        <View
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:background="#4C4360" />

        <!-- ========= TITLE: Calidad del Aire ========= -->
        <TextView
            android:id="@+id/titleCalidadAire"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Calidad del Aire"
            android:textSize="26sp"
            android:textStyle="bold"
            android:gravity="center"
            android:textColor="#4C4360"
            android:paddingTop="25dp"
            android:paddingBottom="10dp"/>

        <!-- ========= EMOJI AIR QUALITY ICON ========= -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:paddingTop="10dp"
            android:paddingBottom="10dp">

            <ImageView
                android:id="@+id/emojiQuality"
                android:layout_width="100dp"
                android:layout_height="100dp"
                android:src="@drawable/ic_air_good"
                android:background="@drawable/rounded_bg_light"
                android:padding="20dp"/>
        </LinearLayout>

        <!-- ========= TIEMPO + DISTANCIA ========= -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="space-around"
            android:orientation="horizontal"
            android:paddingTop="10dp">

            <!-- Tiempo -->
            <LinearLayout
                android:orientation="vertical"
                android:gravity="center">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Tiempo"
                    android:textSize="16sp" />

                <TextView
                    android:id="@+id/textTiempo"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:padding="10dp"
                    android:text="10:25"
                    android:textSize="20sp"
                    android:textColor="@android:color/black"
                    android:background="@drawable/rounded_bg_blue"/>
            </LinearLayout>

            <!-- Distancia -->
            <LinearLayout
                android:orientation="vertical"
                android:gravity="center">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Distancia"
                    android:textSize="16sp" />

                <TextView
                    android:id="@+id/textDistancia"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:padding="10dp"
                    android:text="0.75 Km"
                    android:textSize="20sp"
                    android:textColor="@android:color/black"
                    android:background="@drawable/rounded_bg_blue"/>
            </LinearLayout>
        </LinearLayout>

        <!-- ========= GRÁFICO ========= -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Gráfico"
            android:textSize="18sp"
            android:gravity="center"
            android:paddingTop="20dp"
            android:paddingBottom="10dp"/>

        <FrameLayout
            android:id="@+id/graficoContainer"
            android:layout_width="match_parent"
            android:layout_height="250dp"
            android:background="@drawable/rounded_bg_gray"
            android:padding="10dp" />

        <!-- ========= PUNTOS ========= -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Puntos"
            android:textSize="18sp"
            android:gravity="center"
            android:paddingTop="15dp"/>

        <TextView
            android:id="@+id/textPuntos"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="1234"
            android:textSize="22sp"
            android:background="@drawable/rounded_bg_blue"
            android:padding="12dp"
            android:layout_gravity="center"
            android:layout_marginTop="5dp"/>

        <!-- ========= BOTÓN RECOMPENSAS ========= -->
        <Button
            android:id="@+id/botonRecompensas"
            android:layout_width="200dp"
            android:layout_height="wrap_content"
            android:text="Ver Recompensas"
            android:layout_gravity="center"
            android:background="@drawable/rounded_bg_green"
            android:textColor="@android:color/white"
            android:padding="10dp"
            android:layout_marginTop="20dp"/>

    </LinearLayout>
</ScrollView>
