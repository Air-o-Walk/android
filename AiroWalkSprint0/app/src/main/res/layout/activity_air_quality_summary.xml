<?xml version="1.0" encoding="utf-8"?>

<androidx.drawerlayout.widget.DrawerLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/drawerLayout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#EEF1E7">

    <!-- ===== MAIN CONTENT ===== -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <!-- HEADER -->
        <include layout="@layout/header_bar"/>

        <!-- YOUR EXISTING LAYOUT (UNCHANGED) -->
        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="#EEF1E7">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="20dp">


        <!-- ========= TITLE: Calidad del Aire ========= -->
        <TextView
            android:id="@+id/titleCalidadAire"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Calidad del Aire"
            android:textSize="26sp"
            android:textStyle="bold"
            android:gravity="center"
            android:textColor="#4C4360"
            android:paddingTop="25dp"
            android:paddingBottom="10dp"/>
        <!-- ========= RESUMEN DEL AIRE ========= -->
        <TextView
            android:id="@+id/textResumen"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Aún no hay datos de calidad del aire.
            Realiza un recorrido con el dispositivo conectado para ver tu resumen aquí."
            android:textSize="16sp"
            android:textColor="#4C4360"
            android:gravity="center"
            android:paddingTop="5dp"
            android:paddingBottom="15dp"
            android:paddingLeft="15dp"
            android:paddingRight="15dp" />


        <!-- ========= EMOJI AIR QUALITY ICON ========= -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:paddingTop="10dp"
            android:paddingBottom="10dp">

            <ImageView
                android:id="@+id/emojiQuality"
                android:layout_width="100dp"
                android:layout_height="100dp"
                android:src="@drawable/ic_air_good"
                android:background="@drawable/rounded_bg_light"
                android:padding="20dp"/>
        </LinearLayout>


        <!-- ========= TIEMPO + DISTANCIA (Styled Like Puntos) ========= -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:orientation="horizontal"
            android:paddingTop="10dp"
            android:paddingBottom="10dp">

            <!-- TIEMPO -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:gravity="center"
                android:layout_marginEnd="20dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Tiempo"
                    android:textSize="16sp"
                    android:textColor="#4C4360"/>

                <TextView
                    android:id="@+id/textTiempo"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="--"
                    android:textSize="20sp"
                    android:textColor="@android:color/black"
                    android:padding="12dp"
                    android:background="@drawable/rounded_bg_blue"
                    android:layout_marginTop="5dp"/>
            </LinearLayout>

            <!-- DISTANCIA -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:gravity="center">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Pasos"
                    android:textColor="#4C4360"
                    android:textSize="16sp" />

                <TextView
                    android:id="@+id/textDistancia"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="5dp"
                    android:background="@drawable/rounded_bg_blue"
                    android:padding="12dp"
                    android:text="--"
                    android:textColor="@android:color/black"
                    android:textSize="20sp" />
            </LinearLayout>

        </LinearLayout>


        <!-- ========= GRÁFICO ========= -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Gráfico"
            android:textSize="18sp"
            android:gravity="center"
            android:paddingTop="20dp"
            android:paddingBottom="10dp"/>

        <com.github.mikephil.charting.charts.LineChart
            android:id="@+id/airQualityChart"
            android:layout_width="match_parent"
            android:layout_height="250dp"
            android:background="@drawable/rounded_bg_gray"
            android:padding="10dp"
            tools:ignore="MissingClass" />



        <!-- ========= PUNTOS ========= -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center"
            android:paddingTop="20dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="5dp"
                android:text="Puntos obtenido hoy"
                android:textColor="#4C4360"
                android:textSize="16sp" />

            <TextView
                android:id="@+id/textPuntos"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:padding="10dp"
                android:text="0"
                android:textSize="20sp"
                android:textColor="@android:color/black"
                android:background="@drawable/rounded_bg_blue"/>
        </LinearLayout>


        <!-- ========= BOTÓN RECOMPENSAS ========= -->
                <Button
                    android:id="@+id/botonRecompensas"
                    android:layout_width="200dp"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:layout_marginTop="20dp"
                    android:background="@drawable/rounded_bg_green"
                    android:onClick="abrirPantallaCanjeos"
                    android:padding="10dp"
                    android:text="Ver Recompensas"

                    android:textColor="@android:color/white"
                    app:backgroundTint="@null" />

            </LinearLayout>
        </ScrollView>

    </LinearLayout>

    <!-- ===== DRAWER MENU ===== -->
    <com.google.android.material.navigation.NavigationView
        android:id="@+id/navigationView"
        android:layout_width="280dp"
        android:layout_height="match_parent"
        android:layout_gravity="start"
        android:background="#504E76"
        app:menu="@menu/drawer_menu"
        app:itemTextColor="@android:color/white"/>

</androidx.drawerlayout.widget.DrawerLayout>